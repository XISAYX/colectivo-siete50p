---
import OptimizedVideo from "@/components/astro/OptimizedVideo.astro";
import About from "@/components/react/About";
import Cases from "@/components/react/Cases";
import ContactSection from "@/components/react/ContactSection";
import Divisions from "@/components/react/Divisions";
import Footer from "@/components/react/Footer";
import Hero from "@/components/react/Hero";
import Navbar from "@/components/react/Navbar";
import { siteConfig } from "@/data/site";
import Layout from "@/layouts/Layout.astro";

const { name, tagline, description, nav, divisions, cases, email, city, socials } =
  siteConfig;
---

<Layout title={`${name} — ${tagline}`} description={description}>
  <Navbar client:load brand={name} links={nav} />
  <main id="contenido">
    <Hero client:load tagline={tagline} description={description} />
    {/* Reserva multimedia: coloca el reel en /public/media/showreel.mp4 */}
    <div class="sr-only">
      <OptimizedVideo src="/media/showreel.mp4" poster="/media/showreel.jpg" />
    </div>
    <About client:visible />
    <Divisions client:visible items={divisions} />
    <Cases client:visible items={cases} />
    <ContactSection client:load />
  </main>
  <Footer name={name} email={email} city={city} socials={socials} />
</Layout>
